source "https://rubygems.org"

# Matches the gem set GitHub Pages' legacy "deploy from branch" build uses,
# so a local `bundle exec jekyll serve` behaves the same as the live build.
gem "github-pages", group: :jekyll_plugins

# Ruby 3+ no longer bundles these by default; jekyll/webrick need them.
gem "webrick"
gem "logger"
gem "csv"
gem "base64"
